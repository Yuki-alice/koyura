CREATE TABLE repositories(
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  url TEXT NOT NULL,
  enabled INTEGER NOT NULL DEFAULT 1
);

selectAllRepositories:
SELECT * FROM repositories;

selectRepositoryById:
SELECT * FROM repositories WHERE id = ?;

insertRepository:
INSERT INTO repositories(id, name, url, enabled) VALUES(?, ?, ?, ?);

updateRepository:
UPDATE repositories SET name = ?, url = ? WHERE id = ?;

updateRepositoryEnabled:
UPDATE repositories SET enabled = ? WHERE id = ?;

deleteRepository:
DELETE FROM repositories WHERE id = ?;

CREATE TABLE origins(
  source_key TEXT PRIMARY KEY,
  kind TEXT NOT NULL,
  repository_id TEXT,
  repository_name TEXT,
  url TEXT
);

selectOriginByKey:
SELECT * FROM origins WHERE source_key = ?;

upsertOrigin:
INSERT OR REPLACE INTO origins(source_key, kind, repository_id, repository_name, url)
VALUES(?, ?, ?, ?, ?);

deleteOrigin:
DELETE FROM origins WHERE source_key = ?;

snapshotOriginsRepositoryName:
UPDATE origins SET repository_name = ? WHERE repository_id = ?;

CREATE TABLE extensions(
  source_key TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  version TEXT NOT NULL,
  file_name TEXT NOT NULL,
  origin_kind TEXT NOT NULL,
  origin_repository_id TEXT,
  origin_repository_name TEXT,
  origin_url TEXT
);

selectAllExtensions:
SELECT * FROM extensions;

selectExtensionByKey:
SELECT * FROM extensions WHERE source_key = ?;

upsertExtension:
INSERT OR REPLACE INTO extensions(source_key, name, version, file_name, origin_kind, origin_repository_id, origin_repository_name, origin_url)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

deleteExtension:
DELETE FROM extensions WHERE source_key = ?;

CREATE TABLE reading_progress(
  source_key TEXT NOT NULL,
  work_id TEXT NOT NULL,
  chapter_id TEXT NOT NULL,
  page_key TEXT NOT NULL,
  page_index INTEGER NOT NULL,
  read_at INTEGER,
  work_title TEXT,
  chapter_title TEXT,
  PRIMARY KEY (source_key, work_id, chapter_id)
);

CREATE INDEX reading_progress_work_idx ON reading_progress(source_key, work_id);

selectProgress:
SELECT * FROM reading_progress WHERE source_key = ? AND work_id = ? AND chapter_id = ?;

selectLatestProgress:
SELECT * FROM reading_progress WHERE source_key = ? AND work_id = ? ORDER BY rowid DESC LIMIT 1;

upsertProgress:
INSERT OR REPLACE INTO reading_progress(source_key, work_id, chapter_id, page_key, page_index)
VALUES(?, ?, ?, ?, ?);

upsertProgressWithMeta:
INSERT OR REPLACE INTO reading_progress(
  source_key, work_id, chapter_id, page_key, page_index,
  read_at, work_title, chapter_title
)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

deleteProgress:
DELETE FROM reading_progress WHERE source_key = ? AND work_id = ? AND chapter_id = ?;

-- 历史可见性（与阅读位置分离）：删除只插隐藏标记，reading_progress 原样保留，
-- 书架续读与历史恢复读的都是进度行；重新阅读保存时删标记恢复可见。
-- 新库由 Schema.create 落地，老库由 ensureHistoryVisibilitySchema 补齐（见 5.sqm）。
CREATE TABLE IF NOT EXISTS history_hidden(
  source_key TEXT NOT NULL,
  work_id TEXT NOT NULL,
  PRIMARY KEY (source_key, work_id)
);

hideHistoryEntry:
INSERT OR IGNORE INTO history_hidden(source_key, work_id) VALUES(?, ?);

hideAllHistory:
INSERT OR IGNORE INTO history_hidden(source_key, work_id)
SELECT DISTINCT source_key, work_id FROM reading_progress;

unhideHistoryEntry:
DELETE FROM history_hidden WHERE source_key = ? AND work_id = ?;

selectHiddenHistory:
SELECT * FROM history_hidden;

selectHistoryLatest:
SELECT * FROM reading_progress AS p
WHERE NOT EXISTS (
  SELECT 1 FROM reading_progress AS q
  WHERE q.source_key = p.source_key AND q.work_id = p.work_id AND q.rowid > p.rowid
)
AND NOT EXISTS (
  SELECT 1 FROM history_hidden AS h
  WHERE h.source_key = p.source_key AND h.work_id = p.work_id
)
ORDER BY p.read_at IS NULL, p.read_at DESC, p.rowid DESC;

selectHistoryLatestAll:
SELECT * FROM reading_progress AS p
WHERE NOT EXISTS (
  SELECT 1 FROM reading_progress AS q
  WHERE q.source_key = p.source_key AND q.work_id = p.work_id AND q.rowid > p.rowid
);

selectProgressBySource:
SELECT * FROM reading_progress WHERE source_key = ?;

selectProgressByWork:
SELECT * FROM reading_progress WHERE source_key = ? AND work_id = ?;

-- 书架持久化（第 4 版 schema）：收藏身份为三元主键 (source_key, kind, work_id)，
-- kind 取 COMIC 或 NOVEL；未读数/已下载数/继续阅读章为派生值，不存快照。
CREATE TABLE IF NOT EXISTS library_manga(
  source_key TEXT NOT NULL,
  kind TEXT NOT NULL,
  work_id TEXT NOT NULL,
  title TEXT NOT NULL DEFAULT '',
  cover_url TEXT NOT NULL DEFAULT '',
  source_name TEXT,
  added_at INTEGER NOT NULL DEFAULT 0,
  last_update_check INTEGER,
  PRIMARY KEY (source_key, kind, work_id)
);

CREATE INDEX IF NOT EXISTS library_manga_title_idx ON library_manga(title);

CREATE TABLE IF NOT EXISTS library_category(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0,
  hidden INTEGER NOT NULL DEFAULT 0,
  is_default INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS library_manga_category(
  source_key TEXT NOT NULL,
  kind TEXT NOT NULL,
  work_id TEXT NOT NULL,
  category_id INTEGER NOT NULL,
  PRIMARY KEY (source_key, kind, work_id, category_id)
);

CREATE INDEX IF NOT EXISTS library_manga_category_cat_idx ON library_manga_category(category_id);

CREATE TABLE IF NOT EXISTS library_prefs(
  pref_key TEXT PRIMARY KEY,
  pref_value TEXT NOT NULL
);

selectLibraryAll:
SELECT * FROM library_manga;

selectLibraryByKey:
SELECT * FROM library_manga WHERE source_key = ? AND kind = ? AND work_id = ?;

selectLibraryBySource:
SELECT * FROM library_manga WHERE source_key = ?;

insertLibraryManga:
INSERT OR IGNORE INTO library_manga(source_key, kind, work_id, title, cover_url, source_name, added_at, last_update_check)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

upsertLibraryManga:
INSERT OR REPLACE INTO library_manga(source_key, kind, work_id, title, cover_url, source_name, added_at, last_update_check)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

updateLibrarySnapshot:
UPDATE library_manga SET title = ?, cover_url = ?, source_name = ?, last_update_check = ? WHERE source_key = ? AND kind = ? AND work_id = ?;

deleteLibraryManga:
DELETE FROM library_manga WHERE source_key = ? AND kind = ? AND work_id = ?;

selectCategoriesOrdered:
SELECT * FROM library_category ORDER BY sort_order, id;

selectCategoryById:
SELECT * FROM library_category WHERE id = ?;

insertCategory:
INSERT INTO library_category(name, sort_order, hidden, is_default) VALUES(?, ?, ?, ?);

updateCategoryName:
UPDATE library_category SET name = ? WHERE id = ?;

updateCategoryHidden:
UPDATE library_category SET hidden = ? WHERE id = ?;

updateCategoryOrder:
UPDATE library_category SET sort_order = ? WHERE id = ?;

deleteCategory:
DELETE FROM library_category WHERE id = ?;

countCategories:
SELECT COUNT(*) FROM library_category;

selectMappingsForWork:
SELECT * FROM library_manga_category WHERE source_key = ? AND kind = ? AND work_id = ?;

selectAllMappings:
SELECT * FROM library_manga_category;

selectMappingsForCategory:
SELECT * FROM library_manga_category WHERE category_id = ?;

selectMappingsBySource:
SELECT * FROM library_manga_category WHERE source_key = ?;

insertMapping:
INSERT OR IGNORE INTO library_manga_category(source_key, kind, work_id, category_id) VALUES(?, ?, ?, ?);

deleteMapping:
DELETE FROM library_manga_category WHERE source_key = ? AND kind = ? AND work_id = ? AND category_id = ?;

deleteMappingsForWork:
DELETE FROM library_manga_category WHERE source_key = ? AND kind = ? AND work_id = ?;

deleteMappingsForCategory:
DELETE FROM library_manga_category WHERE category_id = ?;

selectPref:
SELECT * FROM library_prefs WHERE pref_key = ?;

selectAllPrefs:
SELECT * FROM library_prefs;

upsertPref:
INSERT OR REPLACE INTO library_prefs(pref_key, pref_value) VALUES(?, ?);

deletePref:
DELETE FROM library_prefs WHERE pref_key = ?;

seedDefaultCategory:
INSERT INTO library_category(name, sort_order, hidden, is_default)
SELECT '默认', 0, 0, 1 WHERE NOT EXISTS (SELECT 1 FROM library_category);

-- 章节目录与已读状态（第 6 版）：按三元主键 + 章节 ID 隔离，
-- `is_read` 0/1，`sort_index` 保留源顺序；`reading_progress` 的页键/页码/隐藏标记原样保留。
CREATE TABLE IF NOT EXISTS library_chapter(
  source_key TEXT NOT NULL,
  kind TEXT NOT NULL,
  work_id TEXT NOT NULL,
  chapter_id TEXT NOT NULL,
  title TEXT NOT NULL DEFAULT '',
  sort_index INTEGER NOT NULL DEFAULT 0,
  is_read INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (source_key, kind, work_id, chapter_id)
);

CREATE INDEX IF NOT EXISTS library_chapter_work_idx ON library_chapter(source_key, kind, work_id);

selectChaptersForWork:
SELECT * FROM library_chapter
WHERE source_key = ? AND kind = ? AND work_id = ?
ORDER BY sort_index, chapter_id;

selectChapterById:
SELECT * FROM library_chapter
WHERE source_key = ? AND kind = ? AND work_id = ? AND chapter_id = ?;

insertChapterIgnore:
INSERT OR IGNORE INTO library_chapter(source_key, kind, work_id, chapter_id, title, sort_index, is_read)
VALUES(?, ?, ?, ?, ?, ?, ?);

upsertChapter:
INSERT OR REPLACE INTO library_chapter(source_key, kind, work_id, chapter_id, title, sort_index, is_read)
VALUES(?, ?, ?, ?, ?, ?, ?);

updateChapterMeta:
UPDATE library_chapter SET title = ?, sort_index = ? WHERE source_key = ? AND kind = ? AND work_id = ? AND chapter_id = ?;

updateChapterRead:
UPDATE library_chapter SET is_read = ? WHERE source_key = ? AND kind = ? AND work_id = ? AND chapter_id = ?;

updateChaptersReadForWork:
UPDATE library_chapter SET is_read = ? WHERE source_key = ? AND kind = ? AND work_id = ?;

deleteChaptersForWork:
DELETE FROM library_chapter WHERE source_key = ? AND kind = ? AND work_id = ?;
