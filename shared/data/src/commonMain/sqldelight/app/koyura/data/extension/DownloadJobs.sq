CREATE TABLE IF NOT EXISTS download_jobs (
  id TEXT NOT NULL PRIMARY KEY,
  source_key TEXT NOT NULL,
  work_id TEXT NOT NULL,
  chapter_id TEXT NOT NULL,
  status TEXT NOT NULL,
  completed_pages INTEGER NOT NULL DEFAULT 0,
  total_pages INTEGER,
  UNIQUE (source_key, work_id, chapter_id)
);

selectAllDownloads:
SELECT * FROM download_jobs ORDER BY rowid;

selectDownload:
SELECT * FROM download_jobs WHERE id = ?;

selectDownloadForChapter:
SELECT * FROM download_jobs WHERE source_key = ? AND work_id = ? AND chapter_id = ?;

selectNextDownload:
SELECT * FROM download_jobs WHERE status = 'QUEUED' ORDER BY rowid LIMIT 1;

insertDownload:
INSERT OR IGNORE INTO download_jobs(id, source_key, work_id, chapter_id, status)
VALUES (?, ?, ?, ?, 'QUEUED');

updateDownload:
UPDATE download_jobs SET status = ?, completed_pages = ?, total_pages = ? WHERE id = ?;


countCompletedDownloads:
SELECT COUNT(*) FROM download_jobs WHERE source_key = ? AND work_id = ? AND status = 'COMPLETE';
